<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1>Books</h1>
<p>Welcome, <%= current_admin.full_name %>! <%= link_to "Sign Out", destroy_admin_session_path %></p>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to "Show this book", book %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>

<br>

<%= link_to "User Books", root_path %>
